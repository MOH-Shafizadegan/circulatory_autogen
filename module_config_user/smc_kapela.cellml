                    <apply>
                        <plus/>
                        <ci>Ca_i</ci>
                        <ci>K_mPMCa</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--Plasma membrane Na+-Ca2+ exchanger-->
        <variable initial_value="0.000487" name="g_NCX" units="pA"/>
        <variable initial_value="0.0003" name="d_NCX" units="dimensionless"/>
        <variable initial_value="0.45" name="gamma_NCX" units="dimensionless"/>
        <variable name="R_NCXcGMP" units="dimensionless"/>
        <variable name="phi_F" units="dimensionless"/>
        <variable name="phi_R" units="dimensionless"/>
        <variable name="I_NCX" units="pA"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>R_NCXcGMP</ci>
                <apply>
                    <plus/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <cn cellml:units="dimensionless">0.55</cn>
                            <ci>cGMP</ci>
                        </apply>
                        <apply>
                            <plus/>
                            <ci>cGMP</ci>
                            <cn cellml:units="dimensionless" type="e-notation">4.5<sep/>-2</cn>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>phi_F</ci>
                <apply>
                    <exp/>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <ci>gamma_NCX</ci>
                            <ci>V_m</ci>
                            <ci>F</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>R</ci>
                            <ci>T</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>phi_R</ci>
                <apply>
                    <exp/>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <apply>
                                <minus/>
                                <ci>gamma_NCX</ci>
                                <cn cellml:units="dimensionless">1</cn>
                            </apply>
                            <ci>V_m</ci>
                            <ci>F</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>R</ci>
                            <ci>T</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>I_NCX</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>g_NCX</ci>
                        <ci>R_NCXcGMP</ci>
                        <apply>
                            <minus/>
                            <apply>
                                <times/>
                                <apply>
                                    <power/>
                                    <ci>Na_i</ci>
                                    <cn cellml:units="dimensionless">3</cn>
                                </apply>
                                <ci>Ca_e</ci>
                                <ci>phi_F</ci>
                            </apply>
                            <apply>
                                <times/>
                                <apply>
                                    <power/>
                                    <ci>Na_e</ci>
                                    <cn cellml:units="dimensionless">3</cn>
                                </apply>
                                <ci>Ca_i</ci>
                                <ci>phi_R</ci>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <times/>
                            <ci>d_NCX</ci>
                            <apply>
                                <plus/>
                                <apply>
                                    <times/>
                                    <apply>
                                        <power/>
                                        <ci>Na_e</ci>
                                        <cn cellml:units="dimensionless">3</cn>
                                    </apply>
                                    <ci>Ca_i</ci>
                                </apply>
                                <apply>
                                    <times/>
                                    <apply>
                                        <power/>
                                        <ci>Na_i</ci>
                                        <cn cellml:units="dimensionless">3</cn>
                                    </apply>
                                    <ci>Ca_e</ci>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--Na+-K+ pump-->
        <variable name="I_NaK" units="pA"/>
        <variable initial_value="2.3083" name="Ibar_NaK" units="pA_per_pF"/>
        <variable initial_value="1.1" name="n_HKe" units="dimensionless"/>
        <variable initial_value="1.6" name="K_dKe" units="mM"/>
        <variable initial_value="1.7" name="n_HNai" units="dimensionless"/>
        <variable initial_value="22" name="Na_dNai" units="mM"/>
        <variable name="Q_NaK" units="dimensionless"/>
        <variable initial_value="1.87" name="Q_10" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>Q_NaK</ci>
                <apply>
                    <power/>
                    <ci>Q_10</ci>
                    <apply>
                        <divide/>
                        <apply>
                            <minus/>
                            <ci>T</ci>
                            <cn cellml:units="kelvin">309.15</cn>
                        </apply>
                        <cn cellml:units="kelvin">10</cn>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>I_NaK</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <apply>
                            <divide/>
                            <apply>
                                <times/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <times/>
                                        <ci>C_m</ci>
                                        <ci>Ibar_NaK</ci>
                                        <ci>Q_NaK</ci>
                                        <apply>
                                            <power/>
                                            <ci>K_e</ci>
                                            <ci>n_HKe</ci>
                                        </apply>
                                    </apply>
                                    <apply>
                                        <plus/>
                                        <apply>
                                            <power/>
                                            <ci>K_e</ci>
                                            <ci>n_HKe</ci>
                                        </apply>
                                        <apply>
                                            <power/>
                                            <ci>K_dKe</ci>
                                            <ci>n_HKe</ci>
                                        </apply>
                                    </apply>
                                </apply>
                                <apply>
                                    <power/>
                                    <ci>Na_i</ci>
                                    <ci>n_HNai</ci>
                                </apply>
                            </apply>
                            <apply>
                                <plus/>
                                <apply>
                                    <power/>
                                    <ci>Na_i</ci>
                                    <ci>n_HNai</ci>
                                </apply>
                                <apply>
                                    <power/>
                                    <ci>Na_dNai</ci>
                                    <ci>n_HNai</ci>
                                </apply>
                            </apply>
                        </apply>
                        <apply>
                            <plus/>
                            <ci>V_m</ci>
                            <cn cellml:units="dimensionless">150</cn>
