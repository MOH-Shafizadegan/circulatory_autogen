<?xml version='1.0' encoding='UTF-8'?>
<model name="my_model" xmlns="http://www.cellml.org/cellml/1.1#" xmlns:cellml="http://www.cellml.org/cellml/1.1#">
    <component name="all">
        <variable name="t" units="ms"/>
        <variable name="NO" units="mM"/>
        <variable name="NE" units="mM"/>
        <!-- -->
        <variable initial_value="8314.472" name="R" units="coulomb_mV_per_kelvin_mole"/>
        <variable initial_value="293" name="T" units="kelvin"/>
        <variable initial_value="96485.34" name="F" units="coulomb_per_mole"/>
        <variable initial_value="-59.4" name="V_m" units="mV"/>
        <variable initial_value="25" name="C_m" units="pF"/>
        <!--Reverse potentials-->
        <variable name="E_K" units="mV"/>
        <variable initial_value="5" name="K_e" units="mM"/>
        <variable initial_value="140" name="K_i" units="mM"/>
        <variable name="E_Na" units="mV"/>
        <variable initial_value="140" name="Na_e" units="mM"/>
        <variable initial_value="8.4" name="Na_i" units="mM"/>
        <variable name="E_Ca" units="mV"/>
        <variable initial_value="2" name="Ca_e" units="mM"/>
        <variable initial_value="68.0e-6" name="Ca_i" public_interface="out" units="mM"/>
        <variable name="E_Cl" units="mV"/>
        <variable initial_value="129" name="Cl_e" units="mM"/>
        <variable initial_value="59.4" name="Cl_i" units="mM"/>
        <variable initial_value="1" name="z_K" units="dimensionless"/>
        <variable initial_value="1" name="z_Na" units="dimensionless"/>
        <variable initial_value="2" name="z_Ca" units="dimensionless"/>
        <variable initial_value="-1" name="z_Cl" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>E_K</ci>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <ci>R</ci>
                            <ci>T</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>z_K</ci>
                            <ci>F</ci>
                        </apply>
                    </apply>
                    <apply>
                        <ln/>
                        <apply>
                            <divide/>
                            <ci>K_e</ci>
                            <ci>K_i</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>E_Na</ci>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <ci>R</ci>
                            <ci>T</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>z_Na</ci>
                            <ci>F</ci>
                        </apply>
                    </apply>
                    <apply>
                        <ln/>
                        <apply>
                            <divide/>
                            <ci>Na_e</ci>
                            <ci>Na_i</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>E_Ca</ci>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <ci>R</ci>
                            <ci>T</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>z_Ca</ci>
                            <ci>F</ci>
                        </apply>
                    </apply>
                    <apply>
                        <ln/>
                        <apply>
                            <divide/>
                            <ci>Ca_e</ci>
                            <ci>Ca_i</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>E_Cl</ci>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <ci>R</ci>
                            <ci>T</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>z_Cl</ci>
                            <ci>F</ci>
                        </apply>
                    </apply>
                    <apply>
                        <ln/>
                        <apply>
                            <divide/>
                            <ci>Cl_e</ci>
                            <ci>Cl_i</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--Mechannically overgeslagen!!!!-->
        <!--L_type voltage operated Ca2+ channel-->
        <variable name="dbar_L" units="dimensionless"/>
        <variable name="fbar_L" units="dimensionless"/>
        <variable initial_value="0.000779" name="d_L" units="dimensionless"/>
        <variable initial_value="0.871254" name="f_L" units="dimensionless"/>
        <variable name="tau_dL" units="ms"/>
        <variable name="tau_fL" units="ms"/>
        <variable name="A_m" units="cm_2"/>
        <variable initial_value="1.88e-5" name="P_VOCC" units="cm_per_s"/>
        <variable name="I_VOCC" units="pA"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>A_m</ci>
                <apply>
                    <divide/>
                    <ci>C_m</ci>
                    <cn cellml:units="pF_per_cm_2" type="e-notation">1<sep/>6</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>dbar_L</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <divide/>
                                <apply>
                                    <minus/>
                                    <ci>V_m</ci>
                                </apply>
                                <cn cellml:units="mV">8.3</cn>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>fbar_L</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <divide/>
                                <apply>
                                    <plus/>
                                    <ci>V_m</ci>
                                    <cn cellml:units="mV">42</cn>
                                </apply>
                                <cn cellml:units="mV">9.1</cn>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>tau_dL</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <cn cellml:units="ms">2.5</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <minus/>
                                <apply>
                                    <power/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <plus/>
                                            <ci>V_m</ci>
                                            <cn cellml:units="mV">40</cn>
                                        </apply>
                                        <cn cellml:units="mV">30</cn>
                                    </apply>
                                    <cn cellml:units="dimensionless">2</cn>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <cn cellml:units="ms">1.15</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>tau_fL</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <cn cellml:units="ms">65</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <minus/>
                                <apply>
                                    <power/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <plus/>
                                            <ci>V_m</ci>
                                            <cn cellml:units="mV">35</cn>
                                        </apply>
                                        <cn cellml:units="mV">25</cn>
                                    </apply>
                                    <cn cellml:units="dimensionless">2</cn>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <cn cellml:units="ms">45</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>I_VOCC</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <apply>
                            <divide/>
                            <apply>
                                <times/>
                                <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                <ci>A_m</ci>
                                <ci>P_VOCC</ci>
                                <ci>d_L</ci>
                                <ci>f_L</ci>
                                <ci>V_m</ci>
                                <apply>
                                    <power/>
                                    <apply>
                                        <times/>
                                        <ci>z_Ca</ci>
                                        <ci>F</ci>
                                    </apply>
                                    <cn cellml:units="dimensionless">2</cn>
                                </apply>
                            </apply>
                            <apply>
                                <times/>
                                <ci>R</ci>
                                <ci>T</ci>
                            </apply>
                        </apply>
                        <apply>
                            <minus/>
                            <ci>Ca_e</ci>
                            <apply>
                                <times/>
                                <ci>Ca_i</ci>
                                <apply>
                                    <exp/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <ci>V_m</ci>
                                            <ci>z_Ca</ci>
                                            <ci>F</ci>
                                        </apply>
                                        <apply>
                                            <times/>
                                            <ci>R</ci>
                                            <ci>T</ci>
                                        </apply>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <minus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <divide/>
                                <apply>
                                    <times/>
                                    <ci>V_m</ci>
                                    <ci>z_Ca</ci>
                                    <ci>F</ci>
                                </apply>
                                <apply>
                                    <times/>
                                    <ci>R</ci>
                                    <ci>T</ci>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>d_L</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>dbar_L</ci>
                        <ci>d_L</ci>
                    </apply>
                    <ci>tau_dL</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>f_L</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>fbar_L</ci>
                        <ci>f_L</ci>
                    </apply>
                    <ci>tau_fL</ci>
                </apply>
            </apply>
        </math>
        <!--Large conductance Ca2+ activated K channel-->
        <variable name="P_KCa" units="dimensionless"/>
        <variable initial_value="0.00316" name="p_f" units="dimensionless"/>
        <variable initial_value="0.00316" name="p_s" units="dimensionless"/>
        <variable initial_value="0" name="cGMP" units="mM"/>
        <variable name="R_NO" units="dimensionless"/>
        <variable initial_value="76" name="dV_50KCacGMP" units="mV"/>
        <variable initial_value="46.3" name="dV_50KCaNO" units="mV"/>
        <variable name="pbar_0" units="dimensionless"/>
        <variable name="V_50KCa" units="mV"/>
        <variable name="I_BKCa" units="pA"/>
        <variable initial_value="6.6e+6" name="N_BKCa" units="per_cm_2"/>
        <variable initial_value="0.84" name="tau_pf" units="ms"/>
        <variable initial_value="35.9" name="tau_ps" units="ms"/>
        <variable name="R_cGMP" units="dimensionless"/>
        <variable initial_value="3.9e-13" name="P_BKCa" units="cm_3_per_s"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>P_KCa</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">0.17</cn>
                        <ci>p_f</ci>
                    </apply>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">0.83</cn>
                        <ci>p_s</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>R_NO</ci>
                <apply>
                    <divide/>
                    <ci>NO</ci>
                    <apply>
                        <plus/>
                        <ci>NO</ci>
                        <cn cellml:units="mM" type="e-notation">0.2<sep/>-3</cn>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>R_cGMP</ci>
                <apply>
                    <divide/>
                    <apply>
                        <power/>
                        <ci>cGMP</ci>
                        <cn cellml:units="dimensionless">2</cn>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <power/>
                            <ci>cGMP</ci>
                            <cn cellml:units="dimensionless">2</cn>
                        </apply>
                        <apply>
                            <power/>
                            <cn cellml:units="mM" type="e-notation">1.5<sep/>-3</cn>
                            <cn cellml:units="dimensionless">2</cn>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>V_50KCa</ci>
                <apply>
                    <minus/>
                    <apply>
                        <minus/>
                        <apply>
                            <minus/>
                            <apply>
                                <times/>
                                <apply>
                                    <minus/>
                                    <cn cellml:units="dimensionless">41.7</cn>
                                </apply>
                                <apply>
                                    <log/>
                                    <apply>
                                        <divide/>
                                        <ci>Ca_i</ci>
                                        <cn cellml:units="mM">1</cn>
                                    </apply>
                                </apply>
                            </apply>
                            <cn cellml:units="dimensionless">128.2</cn>
                        </apply>
                        <apply>
                            <times/>
                            <ci>dV_50KCaNO</ci>
                            <ci>R_NO</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>dV_50KCacGMP</ci>
                        <ci>R_cGMP</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>pbar_0</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <divide/>
                                <apply>
                                    <minus/>
                                    <apply>
                                        <minus/>
                                        <ci>V_m</ci>
                                        <ci>V_50KCa</ci>
                                    </apply>
                                </apply>
                                <cn cellml:units="mV">18.25</cn>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>I_BKCa</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <apply>
                            <divide/>
                            <apply>
                                <times/>
                                <cn cellml:units="dimensionless" type="e-notation">1<sep/>6</cn>
                                <ci>A_m</ci>
                                <ci>N_BKCa</ci>
                                <ci>P_BKCa</ci>
                                <ci>P_KCa</ci>
                                <ci>V_m</ci>
                                <apply>
                                    <power/>
                                    <apply>
                                        <times/>
                                        <ci>z_K</ci>
                                        <ci>F</ci>
                                    </apply>
                                    <cn cellml:units="dimensionless">2</cn>
                                </apply>
                            </apply>
                            <apply>
                                <times/>
                                <ci>R</ci>
                                <ci>T</ci>
                            </apply>
                        </apply>
                        <apply>
                            <minus/>
                            <ci>K_e</ci>
                            <apply>
                                <times/>
                                <ci>K_i</ci>
                                <apply>
                                    <exp/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <ci>V_m</ci>
                                            <ci>z_K</ci>
                                            <ci>F</ci>
                                        </apply>
                                        <apply>
                                            <times/>
                                            <ci>R</ci>
                                            <ci>T</ci>
                                        </apply>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <minus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <divide/>
                                <apply>
                                    <times/>
                                    <ci>V_m</ci>
                                    <ci>z_K</ci>
                                    <ci>F</ci>
                                </apply>
                                <apply>
                                    <times/>
                                    <ci>R</ci>
                                    <ci>T</ci>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>p_f</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>pbar_0</ci>
                        <ci>p_f</ci>
                    </apply>
                    <ci>tau_pf</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>p_s</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>pbar_0</ci>
                        <ci>p_s</ci>
                    </apply>
                    <ci>tau_ps</ci>
                </apply>
            </apply>
        </math>
        <!--Voltage Dependent K+ channel-->
        <variable name="pbar_K" units="dimensionless"/>
        <variable name="qbar" units="dimensionless"/>
        <variable name="tau_pK" units="ms"/>
        <variable name="I_Kv" units="pA"/>
        <variable initial_value="1.35" name="g_Kv" units="nS"/>
        <variable initial_value="0.03817" name="p_K" units="dimensionless"/>
        <variable initial_value="0.79991" name="q_1" units="dimensionless"/>
        <variable initial_value="0.7991" name="q_2" units="dimensionless"/>
        <variable initial_value="371" name="tau_q1" units="ms"/>
        <variable initial_value="2884" name="tau_q2" units="ms"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>pbar_K</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <divide/>
                                <apply>
                                    <minus/>
                                    <apply>
                                        <plus/>
                                        <ci>V_m</ci>
                                        <cn cellml:units="dimensionless">11</cn>
                                    </apply>
                                </apply>
                                <cn cellml:units="dimensionless">15</cn>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>qbar</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <divide/>
                                <apply>
                                    <plus/>
                                    <ci>V_m</ci>
                                    <cn cellml:units="dimensionless">40</cn>
                                </apply>
                                <cn cellml:units="dimensionless">14</cn>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>tau_pK</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dimensionless">61.49</cn>
                    <apply>
                        <exp/>
                        <apply>
                            <times/>
                            <apply>
                                <minus/>
                                <cn cellml:units="dimensionless">0.0268</cn>
                            </apply>
                            <ci>V_m</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>I_Kv</ci>
                <apply>
                    <times/>
                    <ci>g_Kv</ci>
                    <ci>p_K</ci>
                    <apply>
                        <plus/>
                        <apply>
                            <times/>
                            <cn cellml:units="dimensionless">0.45</cn>
                            <ci>q_1</ci>
                        </apply>
                        <apply>
                            <times/>
                            <cn cellml:units="dimensionless">0.55</cn>
                            <ci>q_2</ci>
                        </apply>
                    </apply>
                    <apply>
                        <minus/>
                        <ci>V_m</ci>
                        <ci>E_K</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>p_K</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>pbar_K</ci>
                        <ci>p_K</ci>
                    </apply>
                    <ci>tau_pK</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>q_1</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>qbar</ci>
                        <ci>q_1</ci>
                    </apply>
                    <ci>tau_q1</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>q_2</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>qbar</ci>
                        <ci>q_2</ci>
                    </apply>
                    <ci>tau_q2</ci>
                </apply>
            </apply>
        </math>
        <!--unspecified K+ leak channel including ATP-sensitive K+ channel-->
        <variable name="I_Kleak" units="pA"/>
        <variable initial_value="0.067" name="g_Kleak" units="nS"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>I_Kleak</ci>
                <apply>
                    <times/>
                    <ci>g_Kleak</ci>
                    <apply>
                        <minus/>
                        <ci>V_m</ci>
                        <ci>E_K</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--Non-selective cation channel-->
        <variable name="DAG" units="mM"/>
        <variable name="Po_NSC" units="dimensionless"/>
        <variable initial_value="5.11e-7" name="P_NaNSC" units="cm_per_s"/>
        <variable name="P_KNSC" units="cm_per_s"/>
        <variable name="P_CaNSC" units="cm_per_s"/>
        <variable initial_value="0.0244" name="dmin_NSC" units="dimensionless"/>
        <variable initial_value="3e-3" name="K_NSC" units="mM"/>
        <variable name="I_NaNSC" units="pA"/>
        <variable name="I_KNSC" units="pA"/>
        <variable name="I_CaNSC" units="pA"/>
        <variable name="I_NSC" units="pA"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>P_KNSC</ci>
                <apply>
