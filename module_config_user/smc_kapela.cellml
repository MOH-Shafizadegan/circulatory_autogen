                    <ci>P_NaNSC</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>P_CaNSC</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dimensionless">4.54</cn>
                    <ci>P_NaNSC</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>DAG</ci>
                <ci>IP_3</ci>
            </apply>
            <apply>
                <eq/>
                <ci>Po_NSC</ci>
                <apply>
                    <plus/>
                    <cn cellml:units="dimensionless">0.4344</cn>
                    <apply>
                        <divide/>
                        <cn cellml:units="dimensionless">0.5656</cn>
                        <apply>
                            <plus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <apply>
                                <exp/>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <minus/>
                                        <apply>
                                            <minus/>
                                            <ci>V_m</ci>
                                            <cn cellml:units="dimensionless">47.12</cn>
                                        </apply>
                                    </apply>
                                    <cn cellml:units="dimensionless">24.24</cn>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>I_NaNSC</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <apply>
                            <divide/>
                            <apply>
                                <times/>
                                <cn cellml:units="dimensionless" type="e-notation">1<sep/>+6</cn>
                                <ci>A_m</ci>
                                <ci>P_NaNSC</ci>
                                <apply>
                                    <plus/>
                                    <apply>
                                        <divide/>
                                        <ci>DAG</ci>
                                        <apply>
                                            <plus/>
                                            <ci>DAG</ci>
                                            <ci>K_NSC</ci>
                                        </apply>
                                    </apply>
                                    <ci>dmin_NSC</ci>
                                </apply>
                                <ci>Po_NSC</ci>
                                <ci>V_m</ci>
                                <apply>
                                    <power/>
                                    <apply>
                                        <times/>
                                        <ci>z_Na</ci>
                                        <ci>F</ci>
                                    </apply>
                                    <cn cellml:units="dimensionless">2</cn>
                                </apply>
                            </apply>
                            <apply>
                                <times/>
                                <ci>R</ci>
                                <ci>T</ci>
                            </apply>
                        </apply>
                        <apply>
                            <minus/>
                            <ci>Na_e</ci>
                            <apply>
                                <times/>
                                <ci>Na_i</ci>
                                <apply>
                                    <exp/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <ci>V_m</ci>
                                            <ci>z_Na</ci>
                                            <ci>F</ci>
                                        </apply>
                                        <apply>
                                            <times/>
                                            <ci>R</ci>
                                            <ci>T</ci>
                                        </apply>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <minus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <divide/>
                                <apply>
                                    <times/>
                                    <ci>V_m</ci>
                                    <ci>z_Na</ci>
                                    <ci>F</ci>
                                </apply>
                                <apply>
                                    <times/>
                                    <ci>R</ci>
                                    <ci>T</ci>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>I_KNSC</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <apply>
                            <divide/>
                            <apply>
                                <times/>
                                <cn cellml:units="dimensionless" type="e-notation">1<sep/>+6</cn>
                                <ci>A_m</ci>
                                <ci>P_KNSC</ci>
                                <apply>
                                    <plus/>
                                    <apply>
                                        <divide/>
                                        <ci>DAG</ci>
                                        <apply>
                                            <plus/>
                                            <ci>DAG</ci>
                                            <ci>K_NSC</ci>
                                        </apply>
                                    </apply>
                                    <ci>dmin_NSC</ci>
                                </apply>
                                <ci>Po_NSC</ci>
                                <ci>V_m</ci>
                                <apply>
                                    <power/>
                                    <apply>
                                        <times/>
                                        <ci>z_K</ci>
                                        <ci>F</ci>
                                    </apply>
                                    <cn cellml:units="dimensionless">2</cn>
                                </apply>
                            </apply>
                            <apply>
                                <times/>
                                <ci>R</ci>
                                <ci>T</ci>
                            </apply>
                        </apply>
                        <apply>
                            <minus/>
                            <ci>K_e</ci>
                            <apply>
                                <times/>
                                <ci>K_i</ci>
                                <apply>
                                    <exp/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <ci>V_m</ci>
                                            <ci>z_K</ci>
                                            <ci>F</ci>
                                        </apply>
                                        <apply>
                                            <times/>
                                            <ci>R</ci>
                                            <ci>T</ci>
                                        </apply>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <minus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <divide/>
                                <apply>
                                    <times/>
                                    <ci>V_m</ci>
                                    <ci>z_K</ci>
                                    <ci>F</ci>
                                </apply>
                                <apply>
                                    <times/>
                                    <ci>R</ci>
                                    <ci>T</ci>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>I_CaNSC</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <apply>
                            <divide/>
                            <apply>
                                <times/>
                                <cn cellml:units="dimensionless" type="e-notation">1<sep/>+6</cn>
                                <ci>A_m</ci>
                                <ci>P_CaNSC</ci>
                                <ci>dmin_NSC</ci>
                                <ci>Po_NSC</ci>
                                <ci>V_m</ci>
                                <apply>
                                    <power/>
                                    <apply>
                                        <times/>
                                        <ci>z_Ca</ci>
                                        <ci>F</ci>
                                    </apply>
                                    <cn cellml:units="dimensionless">2</cn>
                                </apply>
                            </apply>
                            <apply>
                                <times/>
                                <ci>R</ci>
                                <ci>T</ci>
                            </apply>
                        </apply>
                        <apply>
                            <minus/>
                            <ci>Ca_e</ci>
                            <apply>
                                <times/>
                                <ci>Ca_i</ci>
                                <apply>
                                    <exp/>
                                    <apply>
                                        <divide/>
                                        <apply>
                                            <times/>
                                            <ci>V_m</ci>
                                            <ci>z_Ca</ci>
                                            <ci>F</ci>
                                        </apply>
                                        <apply>
                                            <times/>
                                            <ci>R</ci>
                                            <ci>T</ci>
                                        </apply>
                                    </apply>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <minus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <exp/>
                            <apply>
                                <divide/>
                                <apply>
                                    <times/>
                                    <ci>V_m</ci>
                                    <ci>z_Ca</ci>
                                    <ci>F</ci>
                                </apply>
                                <apply>
                                    <times/>
                                    <ci>R</ci>
                                    <ci>T</ci>
                                </apply>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>I_NSC</ci>
                <apply>
                    <plus/>
                    <ci>I_NaNSC</ci>
                    <ci>I_KNSC</ci>
                    <ci>I_CaNSC</ci>
                </apply>
            </apply>
        </math>
        <!--Store-operated non-selective cation channel-->
        <variable name="Pbar_SOC" units="dimensionless"/>
        <variable initial_value="100" name="tau_SOC" units="ms"/>
        <variable initial_value="1e-4" name="K_SOC" units="mM"/>
        <variable initial_value="0.0083" name="g_CaSOC" units="nS"/>
        <variable initial_value="0" name="P_SOC" units="dimensionless"/>
        <variable name="I_NaSOC" units="pA"/>
        <variable name="I_CaSOC" units="pA"/>
        <variable name="I_SOC" units="pA"/>
        <variable initial_value="0.0575" name="g_NaSOC" units="nS"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>Pbar_SOC</ci>
                <apply>
                    <divide/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <divide/>
                            <ci>Ca_SRu</ci>
                            <ci>K_SOC</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>I_CaSOC</ci>
                <apply>
                    <times/>
                    <ci>g_CaSOC</ci>
                    <ci>P_SOC</ci>
                    <apply>
                        <minus/>
                        <ci>V_m</ci>
                        <ci>E_Ca</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>I_SOC</ci>
                <apply>
                    <plus/>
                    <ci>I_NaSOC</ci>
                    <ci>I_CaSOC</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>I_NaSOC</ci>
                <apply>
                    <times/>
                    <ci>g_NaSOC</ci>
                    <ci>P_SOC</ci>
                    <apply>
                        <minus/>
                        <ci>V_m</ci>
                        <ci>E_Na</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>P_SOC</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>Pbar_SOC</ci>
                        <ci>P_SOC</ci>
                    </apply>
                    <ci>tau_SOC</ci>
                </apply>
            </apply>
        </math>
        <!--Ca2+ activated Cl channel-->
        <variable name="alpha_Cl" units="dimensionless"/>
        <variable initial_value="3.3" name="n_ClcGMP" units="dimensionless"/>
        <variable initial_value="6.4e-3" name="K_ClcGMP" units="mM"/>
        <variable name="K_ClCacGMP" units="mM"/>
        <variable name="P_Cl" units="dimensionless"/>
        <variable initial_value="0.0132" name="Rmin_ClcGMP" units="dimensionless"/>
        <variable initial_value="2" name="n_ClCa" units="dimensionless"/>
        <variable initial_value="3.65e-4" name="K_ClCa" units="mM"/>
        <variable name="I_ClCa" units="pA"/>
        <variable initial_value="0.23" name="g_ClCa" units="nS_per_pF"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>alpha_Cl</ci>
                <apply>
                    <divide/>
                    <apply>
                        <power/>
                        <ci>cGMP</ci>
                        <ci>n_ClcGMP</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <power/>
                            <ci>cGMP</ci>
                            <ci>n_ClcGMP</ci>
                        </apply>
                        <apply>
                            <power/>
                            <ci>K_ClcGMP</ci>
                            <ci>n_ClcGMP</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>K_ClCacGMP</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dimensionless" type="e-notation">4<sep/>-4</cn>
                    <apply>
                        <minus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <times/>
                            <cn cellml:units="dimensionless">0.9</cn>
                            <ci>alpha_Cl</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>P_Cl</ci>
                <apply>
                    <plus/>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <ci>Rmin_ClcGMP</ci>
                            <apply>
                                <power/>
                                <ci>Ca_i</ci>
                                <ci>n_ClCa</ci>
                            </apply>
                        </apply>
                        <apply>
                            <plus/>
                            <apply>
                                <power/>
                                <ci>Ca_i</ci>
                                <ci>n_ClCa</ci>
                            </apply>
                            <apply>
                                <power/>
                                <ci>K_ClCa</ci>
                                <ci>n_ClCa</ci>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <ci>alpha_Cl</ci>
                            <apply>
                                <power/>
                                <ci>Ca_i</ci>
                                <ci>n_ClCa</ci>
                            </apply>
                        </apply>
                        <apply>
                            <plus/>
                            <apply>
                                <power/>
                                <ci>Ca_i</ci>
                                <ci>n_ClCa</ci>
                            </apply>
                            <apply>
                                <power/>
                                <ci>K_ClCacGMP</ci>
                                <ci>n_ClCa</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>I_ClCa</ci>
                <apply>
                    <times/>
                    <ci>C_m</ci>
                    <ci>g_ClCa</ci>
                    <ci>P_Cl</ci>
                    <apply>
                        <minus/>
                        <ci>V_m</ci>
                        <ci>E_Cl</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--Plasma membrane Ca2+-ATPase-->
        <variable name="I_PMCA" units="pA"/>
        <variable initial_value="5.37" name="Ibar_PMCA" units="pA"/>
        <variable initial_value="1.7e-4" name="K_mPMCa" units="mM"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>I_PMCA</ci>
                <apply>
