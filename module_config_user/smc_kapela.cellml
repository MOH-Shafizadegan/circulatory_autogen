                    </apply>
                    <apply>
                        <plus/>
                        <ci>V_m</ci>
                        <cn cellml:units="dimensionless">200</cn>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--Na+-K+-Cl cotransporter -->
        <variable name="R_NaKClcGMP" units="dimensionless"/>
        <variable initial_value="1.79e-17" name="L_NaKCl" units="mole_2_per_J_s_m_2"/>
        <variable name="I_NaNaKCl" units="pA"/>
        <variable name="I_ClNaKCl" units="pA"/>
        <variable name="I_KNaKCl" units="pA"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>R_NaKClcGMP</ci>
                <apply>
                    <plus/>
                    <cn cellml:units="dimensionless">1</cn>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <cn cellml:units="dimensionless">3.5</cn>
                            <ci>cGMP</ci>
                        </apply>
                        <apply>
                            <plus/>
                            <ci>cGMP</ci>
                            <cn cellml:units="dimensionless" type="e-notation">6.4<sep/>-3</cn>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>I_ClNaKCl</ci>
                <apply>
                    <times/>
                    <apply>
                        <minus/>
                        <ci>A_m</ci>
                    </apply>
                    <ci>R_NaKClcGMP</ci>
                    <ci>L_NaKCl</ci>
                    <ci>z_Cl</ci>
                    <ci>F</ci>
                    <ci>R</ci>
                    <ci>T</ci>
                    <apply>
                        <ln/>
                        <apply>
                            <times/>
                            <apply>
                                <divide/>
                                <apply>
                                    <times/>
                                    <ci>Na_e</ci>
                                    <ci>K_e</ci>
                                </apply>
                                <apply>
                                    <times/>
                                    <ci>Na_i</ci>
                                    <ci>K_i</ci>
                                </apply>
                            </apply>
                            <apply>
                                <power/>
                                <apply>
                                    <divide/>
                                    <ci>Cl_e</ci>
                                    <ci>Cl_i</ci>
                                </apply>
                                <cn cellml:units="dimensionless">2</cn>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>I_NaNaKCl</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>I_ClNaKCl</ci>
                    </apply>
                    <cn cellml:units="dimensionless">2</cn>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>I_KNaKCl</ci>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>I_ClNaKCl</ci>
                    </apply>
                    <cn cellml:units="dimensionless">2</cn>
                </apply>
            </apply>
        </math>
        <!--SR IP3 receptor-->
        <variable name="I_IP3" units="pA"/>
        <variable initial_value="2880e-6" name="Ibar_IP3" units="per_ms"/>
        <variable initial_value="0.7" name="Vol_Ca" units="pL"/>
        <variable initial_value="0" name="IP_3" units="mM"/>
        <variable initial_value="1.2e-04" name="K_IP3" units="mM"/>
        <variable initial_value="1.7e-04" name="Kact_IP3" units="mM"/>
        <variable initial_value="0.59524" name="h_IP3" units="dimensionless"/>
        <variable initial_value="1.4" name="kon_IP3" units="per_ms_mM"/>
        <variable initial_value="1e-04" name="Kinh_IP3" units="mM"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>I_IP3</ci>
                <apply>
                    <times/>
                    <ci>Ibar_IP3</ci>
                    <ci>Vol_Ca</ci>
                    <ci>z_Ca</ci>
                    <ci>F</ci>
                    <apply>
                        <power/>
                        <apply>
                            <times/>
                            <apply>
                                <divide/>
                                <apply>
                                    <times/>
                                    <apply>
                                        <divide/>
                                        <ci>IP_3</ci>
                                        <apply>
                                            <plus/>
                                            <ci>IP_3</ci>
                                            <ci>K_IP3</ci>
                                        </apply>
                                    </apply>
                                    <ci>Ca_i</ci>
                                </apply>
                                <apply>
                                    <plus/>
                                    <ci>Ca_i</ci>
                                    <ci>Kact_IP3</ci>
                                </apply>
                            </apply>
                            <ci>h_IP3</ci>
                        </apply>
                        <cn cellml:units="dimensionless">3</cn>
                    </apply>
                    <apply>
                        <minus/>
                        <ci>Ca_SRu</ci>
                        <ci>Ca_i</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>h_IP3</ci>
                </apply>
                <apply>
                    <times/>
                    <ci>kon_IP3</ci>
                    <apply>
                        <minus/>
                        <ci>Kinh_IP3</ci>
                        <apply>
                            <times/>
                            <apply>
                                <plus/>
                                <ci>Ca_i</ci>
                                <ci>Kinh_IP3</ci>
                            </apply>
                            <ci>h_IP3</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--SR SERCA internal diffusion and release-->
        <variable initial_value="0.66" name="Ca_SRu" units="mM"/>
        <variable initial_value="0.57" name="Ca_SRr" units="mM"/>
        <variable initial_value="6.68" name="Ibar_SERCA" units="pA"/>
        <variable initial_value="1e-3" name="Kup_m" units="mM"/>
        <variable initial_value="1000" name="tau_tr" units="ms"/>
        <variable initial_value="1.07e-5" name="R_leak" units="dimensionless"/>
        <variable initial_value="0.0333" name="tau_rel" units="ms"/>
        <variable initial_value="15" name="CSQN_bar" units="mM"/>
        <variable initial_value="0.8" name="K_CSQN" units="mM"/>
        <variable initial_value="0.07" name="Vol_SRu" units="pL"/>
        <variable initial_value="0.007" name="Vol_SRr" units="pL"/>
        <variable name="I_SERCA" units="pA"/>
        <variable name="I_tr" units="pA"/>
        <variable name="I_rel" units="pA"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>I_SERCA</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>Ibar_SERCA</ci>
                        <ci>Ca_i</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <ci>Ca_i</ci>
                        <ci>Kup_m</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>I_tr</ci>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <ci>Vol_SRu</ci>
                            <ci>z_Ca</ci>
                            <ci>F</ci>
                        </apply>
                        <ci>tau_tr</ci>
                    </apply>
                    <apply>
                        <minus/>
                        <ci>Ca_SRu</ci>
                        <ci>Ca_SRr</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>I_rel</ci>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <ci>Vol_SRr</ci>
                            <ci>z_Ca</ci>
                            <ci>F</ci>
                        </apply>
                        <ci>tau_rel</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <apply>
                            <power/>
                            <ci>R_10</ci>
                            <cn cellml:units="dimensionless">2</cn>
                        </apply>
                        <ci>R_leak</ci>
                    </apply>
                    <apply>
                        <minus/>
                        <ci>Ca_SRr</ci>
                        <ci>Ca_i</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>Ca_SRu</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <apply>
                            <minus/>
                            <ci>I_SERCA</ci>
                            <ci>I_tr</ci>
                        </apply>
                        <ci>I_IP3</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>Vol_SRu</ci>
                        <ci>z_Ca</ci>
                        <ci>F</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>Ca_SRr</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <apply>
                            <divide/>
                            <apply>
                                <minus/>
                                <ci>I_tr</ci>
                                <ci>I_rel</ci>
                            </apply>
                            <apply>
                                <times/>
                                <ci>Vol_SRr</ci>
                                <ci>z_Ca</ci>
                                <ci>F</ci>
                            </apply>
                        </apply>
                        <cn cellml:units="dimensionless">1</cn>
                    </apply>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <divide/>
                            <apply>
                                <times/>
                                <ci>CSQN_bar</ci>
                                <ci>K_CSQN</ci>
                            </apply>
                            <apply>
                                <power/>
                                <apply>
                                    <plus/>
                                    <ci>K_CSQN</ci>
                                    <ci>Ca_SRr</ci>
                                </apply>
                                <cn cellml:units="dimensionless">2</cn>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--SR ryanodine receptor-->
        <variable initial_value="2500" name="K_r1" units="per_ms_mM_2"/>
        <variable initial_value="0.0076" name="K_mr1" units="per_ms"/>
        <variable initial_value="0.084" name="K_mr2" units="per_ms"/>
        <variable initial_value="1.05" name="K_r2" units="per_ms_mM"/>
        <variable initial_value="0.0033" name="R_10" units="dimensionless"/>
        <variable initial_value="4e-06" name="R_11" units="dimensionless"/>
        <variable initial_value="0.9955" name="R_01" units="dimensionless"/>
        <variable name="R_00" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>R_00</ci>
                <apply>
                    <minus/>
                    <apply>
                        <minus/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                            <ci>R_10</ci>
                        </apply>
                        <ci>R_11</ci>
                    </apply>
                    <ci>R_01</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>R_10</ci>
                </apply>
                <apply>
                    <plus/>
                    <apply>
                        <minus/>
                        <apply>
                            <times/>
                            <ci>K_r1</ci>
                            <apply>
                                <power/>
                                <ci>Ca_i</ci>
                                <cn cellml:units="dimensionless">2</cn>
                            </apply>
                            <ci>R_00</ci>
                        </apply>
                        <apply>
                            <times/>
                            <apply>
                                <plus/>
                                <ci>K_mr1</ci>
                                <apply>
                                    <times/>
                                    <ci>K_r2</ci>
                                    <ci>Ca_i</ci>
                                </apply>
                            </apply>
                            <ci>R_10</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>K_mr2</ci>
                        <ci>R_11</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>R_11</ci>
                </apply>
                <apply>
                    <plus/>
                    <apply>
                        <minus/>
                        <apply>
                            <times/>
                            <ci>K_r2</ci>
                            <ci>Ca_i</ci>
                            <ci>R_10</ci>
                        </apply>
                        <apply>
                            <times/>
                            <apply>
                                <plus/>
                                <ci>K_mr1</ci>
                                <ci>K_mr2</ci>
                            </apply>
                            <ci>R_11</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>K_r1</ci>
                        <apply>
                            <power/>
                            <ci>Ca_i</ci>
                            <cn cellml:units="dimensionless">2</cn>
                        </apply>
                        <ci>R_01</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>R_01</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <plus/>
                        <apply>
                            <times/>
                            <ci>K_r2</ci>
                            <ci>Ca_i</ci>
                            <ci>R_00</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>K_mr1</ci>
                            <ci>R_11</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <plus/>
                            <ci>K_mr2</ci>
                            <apply>
                                <times/>
                                <ci>K_r1</ci>
                                <apply>
                                    <power/>
                                    <ci>Ca_i</ci>
                                    <cn cellml:units="dimensionless">2</cn>
                                </apply>
                            </apply>
                        </apply>
                        <ci>R_01</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--alpha_1-adrenoreceptor activation and IP3 formation-->
        <variable initial_value="1.75e-7" name="k_rG" units="per_ms"/>
        <variable initial_value="0.85" name="xi_G" units="dimensionless"/>
        <variable initial_value="2e4" name="R_TG" units="dimensionless"/>
        <variable initial_value="0.1e-3" name="k_pG" units="per_ms"/>
        <variable initial_value="0.01" name="K_1G" units="mM"/>
        <variable initial_value="6e-6" name="k_eG" units="per_ms"/>
        <variable initial_value="0.2" name="K_2G" units="mM"/>
        <variable initial_value="0.17e-3" name="k_aG" units="per_ms"/>
        <variable initial_value="1.5e-3" name="k_dG" units="per_ms"/>
        <variable initial_value="2.781e-8" name="alpha_G" units="per_ms"/>
        <variable initial_value="0.4e-3" name="K_cG" units="mM"/>
        <variable initial_value="1.25e-3" name="k_degG" units="per_ms"/>
        <variable initial_value="0.015e-3" name="r_rG" units="per_ms"/>
        <variable initial_value="5e7" name="PIP_2T" units="dimensionless"/>
        <variable initial_value="1.7e4" name="RS_G" units="dimensionless"/>
        <variable name="rho_rG" units="dimensionless"/>
        <variable name="r_hG" units="per_ms"/>
        <variable initial_value="0" name="G" units="mM"/>
        <variable initial_value="0" name="RS_PG" units="dimensionless"/>
        <variable initial_value="5e7" name="PIP_2" units="dimensionless"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>rho_rG</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>NE</ci>
                        <ci>RS_G</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>xi_G</ci>
                        <ci>R_TG</ci>
                        <apply>
                            <plus/>
                            <ci>K_1G</ci>
                            <ci>NE</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>r_hG</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>alpha_G</ci>
                        <ci>G</ci>
                        <ci>Ca_i</ci>
                    </apply>
                    <apply>
                        <plus/>
                        <ci>Ca_i</ci>
                        <ci>K_cG</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>RS_G</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <minus/>
                        <apply>
                            <times/>
                            <ci>k_rG</ci>
                            <ci>xi_G</ci>
                            <ci>R_TG</ci>
                        </apply>
                        <apply>
                            <times/>
                            <apply>
                                <plus/>
                                <ci>k_rG</ci>
                                <apply>
                                    <divide/>
                                    <apply>
                                        <times/>
                                        <ci>k_pG</ci>
                                        <ci>NE</ci>
                                    </apply>
                                    <apply>
                                        <plus/>
                                        <ci>K_1G</ci>
                                        <ci>NE</ci>
                                    </apply>
                                </apply>
                            </apply>
                            <ci>RS_G</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>k_rG</ci>
                        <ci>RS_PG</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>RS_PG</ci>
                </apply>
                <apply>
                    <times/>
                    <ci>NE</ci>
                    <apply>
                        <minus/>
                        <apply>
                            <divide/>
                            <apply>
                                <times/>
                                <ci>k_pG</ci>
                                <ci>RS_G</ci>
                            </apply>
                            <apply>
                                <plus/>
                                <ci>K_1G</ci>
                                <ci>NE</ci>
                            </apply>
                        </apply>
                        <apply>
                            <divide/>
                            <apply>
                                <times/>
                                <ci>k_eG</ci>
                                <ci>RS_PG</ci>
                            </apply>
                            <apply>
                                <plus/>
                                <ci>K_2G</ci>
                                <ci>NE</ci>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>G</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <times/>
                        <ci>k_aG</ci>
                        <apply>
                            <plus/>
                            <ci>delta_G0</ci>
                            <ci>rho_rG</ci>
                        </apply>
                        <apply>
                            <minus/>
                            <ci>G_TG</ci>
                            <ci>G</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>k_dG</ci>
                        <ci>G</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>IP_3</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <ci>r_hG</ci>
                            <ci>PIP_2</ci>
                        </apply>
                        <ci>gamma_G</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>k_degG</ci>
                        <ci>IP_3</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>PIP_2</ci>
                </apply>
                <apply>
                    <plus/>
                    <apply>
                        <minus/>
                        <apply>
                            <times/>
                            <apply>
                                <minus/>
                                <apply>
                                    <plus/>
                                    <ci>r_hG</ci>
                                    <ci>r_rG</ci>
                                </apply>
                            </apply>
                            <ci>PIP_2</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>r_rG</ci>
                            <ci>gamma_G</ci>
                            <ci>IP_3</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>r_rG</ci>
                        <ci>PIP_2T</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--sGC activation and cGMP formation-->
        <variable initial_value="1.26e-7" name="Vmax_cGMP" units="mM_per_ms"/>
        <variable initial_value="4.2" name="k_3sGC" units="per_ms_mM"/>
        <variable initial_value="0.1e-6" name="k_m2sGC" units="per_ms"/>
        <variable initial_value="0.1e-3" name="k_DrsGC" units="per_ms"/>
        <variable initial_value="0.0695e-3" name="k_pdecGMP" units="per_ms"/>
        <variable initial_value="1e-3" name="K_mpde" units="mM"/>
        <variable initial_value="0" name="V_cGMP" units="mV"/>
        <variable name="Vbar_cGMP" units="mM_per_ms"/>
        <variable name="tau_sGC" units="ms"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>Vbar_cGMP</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>Vmax_cGMP</ci>
                        <apply>
                            <plus/>
                            <apply>
                                <times/>
                                <ci>B5_sGC</ci>
                                <ci>NO</ci>
                            </apply>
                            <apply>
                                <power/>
                                <ci>NO</ci>
                                <cn cellml:units="dimensionless">2</cn>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <plus/>
                        <ci>A0_sGC</ci>
                        <apply>
                            <times/>
                            <ci>A1_sGC</ci>
                            <ci>NO</ci>
                        </apply>
                        <apply>
                            <power/>
                            <ci>NO</ci>
                            <cn cellml:units="dimensionless">2</cn>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>V_cGMP</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>Vbar_cGMP</ci>
                        <ci>V_cGMP</ci>
                    </apply>
                    <ci>tau_sGC</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>cGMP</ci>
                </apply>
                <apply>
                    <minus/>
                    <ci>V_cGMP</ci>
                    <apply>
                        <divide/>
                        <apply>
                            <times/>
                            <ci>k_pdecGMP</ci>
                            <apply>
                                <power/>
                                <ci>cGMP</ci>
                                <cn cellml:units="dimensionless">2</cn>
                            </apply>
                        </apply>
                        <apply>
                            <plus/>
                            <ci>cGMP</ci>
                            <ci>K_mpde</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <!--tau_sGC           = 1{dimensionless}/(k_3sGC*NO+k_DrsGC)*(Vbar_cGMP-V_cGMP >= 0{mV})+1{dimensionless}/(k_m2sGC+k_DrsGC)*(Vbar_cGMP-V_cGMP < 0{mV});-->
            <apply>
                <eq/>
                <ci>tau_sGC</ci>
                <piecewise>
                    <piece>
                        <apply>
                            <divide/>
                            <cn cellml:units="dimensionless">1</cn>
                            <apply>
                                <plus/>
                                <apply>
                                    <times/>
                                    <ci>k_3sGC</ci>
                                    <ci>NO</ci>
                                </apply>
                                <ci>k_DrsGC</ci>
                            </apply>
                        </apply>
                        <apply>
                            <or/>
                            <apply>
                                <eq/>
                                <apply>
                                    <minus/>
                                    <ci>Vbar_cGMP</ci>
                                    <ci>V_cGMP</ci>
                                </apply>
                                <cn cellml:units="mM_per_ms">0</cn>
                            </apply>
                            <apply>
                                <gt/>
                                <apply>
                                    <minus/>
                                    <ci>Vbar_cGMP</ci>
                                    <ci>V_cGMP</ci>
                                </apply>
                                <cn cellml:units="mM_per_ms">0</cn>
                            </apply>
                        </apply>
                    </piece>
                    <otherwise>
                        <apply>
                            <divide/>
                            <cn cellml:units="dimensionless">1</cn>
                            <apply>
                                <plus/>
                                <ci>k_m2sGC</ci>
                                <ci>k_DrsGC</ci>
                            </apply>
                        </apply>
                    </otherwise>
                </piecewise>
            </apply>
        </math>
        <!--Ionic balances-->
        <variable initial_value="0" name="I_CasigmaCC" units="pA"/>
        <variable initial_value="0" name="I_CaepsilonCC" units="pA"/>
        <variable initial_value="0" name="I_NasigmaCC" units="pA"/>
        <variable initial_value="0" name="I_NaepsilonCC" units="pA"/>
        <variable name="I_Catotm" units="pA"/>
        <variable name="I_Natotm" units="pA"/>
        <variable name="I_Ktotm" units="pA"/>
        <variable name="I_Cltotm" units="pA"/>
        <variable initial_value="0.1" name="Sbar_CM" units="mM"/>
        <variable initial_value="2.60e-4" name="K_dCM" units="mM"/>
        <variable initial_value="0.1" name="Bbar_F" units="mM"/>
        <variable initial_value="5.298e-4" name="K_dB" units="mM"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>I_Catotm</ci>
                <apply>
                    <plus/>
                    <apply>
                        <minus/>
                        <apply>
                            <plus/>
                            <ci>I_CaSOC</ci>
                            <ci>I_VOCC</ci>
                        </apply>
                        <apply>
                            <times/>
                            <cn cellml:units="dimensionless">2</cn>
                            <ci>I_NCX</ci>
                        </apply>
                    </apply>
                    <ci>I_PMCA</ci>
                    <ci>I_CaNSC</ci>
                    <ci>I_CasigmaCC</ci>
                    <ci>I_CaepsilonCC</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>I_Natotm</ci>
                <apply>
                    <plus/>
                    <ci>I_NaNaKCl</ci>
                    <ci>I_NaSOC</ci>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">3</cn>
                        <ci>I_NaK</ci>
                    </apply>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">3</cn>
                        <ci>I_NCX</ci>
                    </apply>
                    <ci>I_NaNSC</ci>
                    <ci>I_NasigmaCC</ci>
                    <ci>I_NaepsilonCC</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>I_Ktotm</ci>
                <apply>
                    <minus/>
                    <apply>
                        <plus/>
                        <ci>I_KNaKCl</ci>
                        <ci>I_BKCa</ci>
                        <ci>I_Kv</ci>
                        <ci>I_KNSC</ci>
                        <ci>I_Kleak</ci>
                    </apply>
                    <apply>
                        <times/>
                        <cn cellml:units="dimensionless">2</cn>
                        <ci>I_NaK</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>I_Cltotm</ci>
                <apply>
                    <plus/>
                    <ci>I_ClNaKCl</ci>
                    <ci>I_ClCa</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>Ca_i</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <apply>
                            <divide/>
                            <apply>
                                <minus/>
                                <apply>
                                    <minus/>
                                    <apply>
                                        <minus/>
                                        <apply>
                                            <plus/>
                                            <ci>I_Catotm</ci>
                                            <ci>I_SERCA</ci>
                                        </apply>
                                        <ci>I_rel</ci>
                                    </apply>
                                    <ci>I_IP3</ci>
                                </apply>
                            </apply>
                            <apply>
                                <times/>
                                <ci>Vol_Ca</ci>
                                <ci>z_Ca</ci>
                                <ci>F</ci>
                            </apply>
                        </apply>
                        <cn cellml:units="dimensionless">1</cn>
                    </apply>
                    <apply>
                        <plus/>
                        <cn cellml:units="dimensionless">1</cn>
                        <apply>
                            <divide/>
                            <apply>
                                <times/>
                                <ci>Sbar_CM</ci>
                                <ci>K_dCM</ci>
                            </apply>
                            <apply>
                                <power/>
                                <apply>
                                    <plus/>
                                    <ci>K_dCM</ci>
                                    <ci>Ca_i</ci>
                                </apply>
                                <cn cellml:units="dimensionless">2</cn>
                            </apply>
                        </apply>
                        <apply>
                            <divide/>
                            <apply>
                                <times/>
                                <ci>Bbar_F</ci>
                                <ci>K_dB</ci>
                            </apply>
                            <apply>
                                <power/>
                                <apply>
                                    <plus/>
                                    <ci>K_dB</ci>
                                    <ci>Ca_i</ci>
                                </apply>
                                <cn cellml:units="dimensionless">2</cn>
                            </apply>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>Na_i</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>I_Natotm</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>Vol_i</ci>
                        <ci>z_Na</ci>
                        <ci>F</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>K_i</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>I_Ktotm</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>Vol_i</ci>
                        <ci>z_K</ci>
                        <ci>F</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>Cl_i</ci>
                </apply>
                <apply>
                    <divide/>
                    <apply>
                        <minus/>
                        <ci>I_Cltotm</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>Vol_i</ci>
                        <ci>z_Cl</ci>
                        <ci>F</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--Membrane potential-->
        <variable initial_value="0" name="I_stim" units="pA"/>
        <!--VERONDERSTELD-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>V_m</ci>
                </apply>
                <apply>
                    <times/>
                    <apply>
                        <divide/>
                        <apply>
                            <minus/>
                            <cn cellml:units="dimensionless">1</cn>
                        </apply>
                        <ci>C_m</ci>
                    </apply>
                    <apply>
                        <minus/>
                        <apply>
                            <plus/>
                            <ci>I_VOCC</ci>
                            <ci>I_BKCa</ci>
                            <ci>I_Kv</ci>
                            <ci>I_Kleak</ci>
                            <ci>I_NSC</ci>
                            <ci>I_SOC</ci>
                            <ci>I_ClCa</ci>
                            <ci>I_PMCA</ci>
                            <ci>I_NCX</ci>
                            <ci>I_NaK</ci>
                            <ci>I_CasigmaCC</ci>
                            <ci>I_CaepsilonCC</ci>
                            <ci>I_NasigmaCC</ci>
                            <ci>I_NaepsilonCC</ci>
                        </apply>
                        <ci>I_stim</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--alpha1-adrenorecepter activation and IP3 formation        -->
        <variable name="gamma_G" units="mM"/>
        <variable initial_value="6.022e+23" name="N_Avo" units="per_mole"/>
        <variable initial_value="1" name="Vol_i" units="pL"/>
        <variable name="delta_G0" units="dimensionless"/>
        <variable initial_value="0" name="G_0" units="dimensionless"/>
        <variable initial_value="1e+5" name="G_TG" units="dimensionless"/>
        <variable name="B5_sGC" units="mM"/>
        <variable name="A0_sGC" units="mM_2"/>
        <variable name="A1_sGC" units="mM"/>
        <variable initial_value="2e+3" name="k_1sGC" units="per_ms_mM"/>
        <variable initial_value="15e-3" name="k_m1sGC" units="per_ms"/>
        <variable initial_value="0.64e-5" name="k_2sGC" units="per_ms"/>
        <variable initial_value="0.4e-3" name="k_DsGC" units="per_ms"/>
        <!--als hij het zelf niet converteert-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>gamma_G</ci>
                <apply>
                    <times/>
                    <cn cellml:units="dimensionless" type="e-notation">1<sep/>-15</cn>
                    <ci>N_Avo</ci>
                    <ci>Vol_i</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>delta_G0</ci>
                <apply>
                    <divide/>
                    <apply>
                        <times/>
                        <ci>k_dG</ci>
                        <ci>G_0</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>k_aG</ci>
                        <apply>
                            <minus/>
                            <ci>G_TG</ci>
                            <ci>G_0</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <!--sGC activation and cGMP formation-->
            <apply>
                <eq/>
                <ci>B5_sGC</ci>
                <apply>
                    <divide/>
                    <ci>k_2sGC</ci>
                    <ci>k_3sGC</ci>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>A0_sGC</ci>
                <apply>
                    <divide/>
                    <apply>
                        <plus/>
                        <apply>
                            <times/>
                            <apply>
                                <plus/>
                                <ci>k_m1sGC</ci>
                                <ci>k_2sGC</ci>
                            </apply>
                            <ci>k_DsGC</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>k_m1sGC</ci>
                            <ci>k_m2sGC</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>k_1sGC</ci>
                        <ci>k_3sGC</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>A1_sGC</ci>
                <apply>
                    <divide/>
                    <apply>
                        <plus/>
                        <apply>
                            <times/>
                            <apply>
                                <plus/>
                                <ci>k_1sGC</ci>
                                <ci>k_3sGC</ci>
                            </apply>
                            <ci>k_DsGC</ci>
                        </apply>
                        <apply>
                            <times/>
                            <apply>
                                <plus/>
                                <ci>k_2sGC</ci>
                                <ci>k_m2sGC</ci>
                            </apply>
                            <ci>k_1sGC</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>k_1sGC</ci>
                        <ci>k_3sGC</ci>
                    </apply>
                </apply>
            </apply>
        </math>
        <variable initial_value="0.001" name="NE_amp" units="mM"/>
        <variable initial_value="0.001" name="NO_amp" units="mM"/>
        <variable initial_value="200e3" name="NO_tstart" units="ms"/>
        <variable initial_value="300e3" name="NO_tend" units="ms"/>
        <variable initial_value="100e3" name="NE_tstart" units="ms"/>
        <variable initial_value="300e3" name="NE_tend" units="ms"/>
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>NE</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <cn cellml:units="mM">0</cn>
                        <apply>
                            <leq/>
                            <ci>t</ci>
                            <ci>NE_tstart</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>NE_amp</ci>
                        <apply>
                            <and/>
                            <apply>
                                <leq/>
                                <ci>t</ci>
                                <ci>NE_tend</ci>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>t</ci>
                                <ci>NE_tstart</ci>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <cn cellml:units="mM">0</cn>
                        <apply>
                            <gt/>
                            <ci>t</ci>
                            <ci>NE_tend</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>NO</ci>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <cn cellml:units="mM">0</cn>
                        <apply>
                            <leq/>
                            <ci>t</ci>
                            <ci>NO_tstart</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <ci>NO_amp</ci>
                        <apply>
                            <and/>
                            <apply>
                                <leq/>
                                <ci>t</ci>
                                <ci>NO_tend</ci>
                            </apply>
                            <apply>
                                <gt/>
                                <ci>t</ci>
                                <ci>NO_tstart</ci>
                            </apply>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <cn cellml:units="mM">0</cn>
                        <apply>
                            <gt/>
                            <ci>t</ci>
                            <ci>NO_tend</ci>
                        </apply>
                    </apply>
                </apply>
            </apply>
        </math>
        <!--NO = 0{mM}*(t <= NO_tstart)+NO_amp/(NO_tend-NO_tstart)*(t-NO_tstart)*((t <= NO_tend) and (t > NO_tstart))+0{mM}*(t > NO_tend);-->
        <variable initial_value="0.5e-3" name="K_2" units="per_ms"/>
        <variable initial_value="0.4e-3" name="K_3" units="per_ms"/>
        <variable initial_value="0.1e-3" name="K_4" units="per_ms"/>
        <variable initial_value="0.5e-3" name="K_5" units="per_ms"/>
        <variable initial_value="0.1e-3" name="K_7" units="per_ms"/>
        <variable name="K_6" units="per_ms"/>
        <variable name="K_1" units="per_ms"/>
        <variable initial_value="0.9685" name="M" units="dimensionless"/>
        <variable initial_value="0.0063" name="Mp" units="dimensionless"/>
        <variable initial_value="0.0044" name="AMp" units="dimensionless"/>
        <variable initial_value="0.0208" name="AM" units="dimensionless"/>
        <variable name="relativeActivation" units="dimensionless"/>
        <variable initial_value="0.24" name="alpha_Ca" units="dimensionless"/>
        <variable initial_value="1.78e-4" name="K_CaCaM" units="per_mM"/>
        <variable initial_value="17e6" name="gamma" units="per_mM_3_s"/>
        <!--K_1                = sqr(alpha_Ca*Ca_i)/(sqr(alpha_Ca*Ca_i)+sqr(K_CaCaM));
K_1 =  0 {dimensionless};-->
        <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
                <eq/>
                <ci>K_1</ci>
                <apply>
                    <times/>
                    <ci>gamma</ci>
                    <apply>
                        <power/>
                        <ci>Ca_i</ci>
                        <cn cellml:units="dimensionless">3</cn>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>K_6</ci>
                <ci>K_1</ci>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>M</ci>
                </apply>
                <apply>
                    <plus/>
                    <apply>
                        <times/>
                        <apply>
                            <minus/>
                            <ci>K_1</ci>
                        </apply>
                        <ci>M</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>K_2</ci>
                        <ci>Mp</ci>
                    </apply>
                    <apply>
                        <times/>
                        <ci>K_7</ci>
                        <ci>AM</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>Mp</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <plus/>
                        <apply>
                            <times/>
                            <ci>K_4</ci>
                            <ci>AMp</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>K_1</ci>
                            <ci>M</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <plus/>
                            <ci>K_2</ci>
                            <ci>K_3</ci>
                        </apply>
                        <ci>Mp</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>AMp</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <plus/>
                        <apply>
                            <times/>
                            <ci>K_3</ci>
                            <ci>Mp</ci>
                        </apply>
                        <apply>
                            <times/>
                            <ci>K_6</ci>
                            <ci>AM</ci>
                        </apply>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <plus/>
                            <ci>K_4</ci>
                            <ci>K_5</ci>
                        </apply>
                        <ci>AMp</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <apply>
                    <diff/>
                    <bvar>
                        <ci>t</ci>
                    </bvar>
                    <ci>AM</ci>
                </apply>
                <apply>
                    <minus/>
                    <apply>
                        <times/>
                        <ci>K_5</ci>
                        <ci>AMp</ci>
                    </apply>
                    <apply>
                        <times/>
                        <apply>
                            <plus/>
                            <ci>K_7</ci>
                            <ci>K_6</ci>
                        </apply>
                        <ci>AM</ci>
                    </apply>
                </apply>
            </apply>
            <apply>
                <eq/>
                <ci>relativeActivation</ci>
                <apply>
                    <plus/>
                    <ci>AM</ci>
                    <ci>AMp</ci>
                </apply>
            </apply>
        </math>
    </component>
    <units name="coulomb_per_mole">
        <unit units="coulomb"/>
        <unit exponent="-1" units="mole"/>
    </units>
    <units name="per_mole">
        <unit exponent="-1" units="mole"/>
    </units>
    <units name="coulomb_mV_per_kelvin_mole">
        <unit units="coulomb"/>
        <unit prefix="milli" units="volt"/>
        <unit exponent="-1" units="kelvin"/>
        <unit exponent="-1" units="mole"/>
    </units>
    <units name="mM">
        <unit prefix="milli" units="mole"/>
        <unit exponent="-1" units="litre"/>
    </units>
    <units name="per_mM">
        <unit exponent="-1" prefix="milli" units="mole"/>
        <unit units="litre"/>
    </units>
    <units name="mM_2">
        <unit exponent="2" prefix="milli" units="mole"/>
        <unit exponent="-2" units="litre"/>
    </units>
    <units name="mV">
        <unit prefix="milli" units="volt"/>
    </units>
    <units name="ms">
        <unit prefix="milli" units="second"/>
    </units>
    <units name="pF">
        <unit prefix="pico" units="farad"/>
    </units>
    <units name="pA">
        <unit prefix="pico" units="ampere"/>
    </units>
    <units name="cm_2">
        <unit exponent="2" prefix="centi" units="metre"/>
    </units>
    <units name="pF_per_cm_2">
        <unit prefix="pico" units="farad"/>
        <unit exponent="-2" prefix="centi" units="metre"/>
    </units>
    <units name="cm_per_ms">
        <unit prefix="centi" units="metre"/>
        <unit exponent="-1" prefix="milli" units="second"/>
    </units>
    <units name="cm_per_s">
        <unit prefix="centi" units="metre"/>
        <unit exponent="-1" units="second"/>
    </units>
    <units name="per_cm_2">
        <unit exponent="-2" prefix="centi" units="metre"/>
    </units>
    <units name="cm_3_per_s">
        <unit exponent="3" prefix="centi" units="metre"/>
        <unit exponent="-1" units="second"/>
    </units>
    <units name="nS">
        <unit prefix="nano" units="siemens"/>
    </units>
    <units name="nS_per_pF">
        <unit prefix="nano" units="siemens"/>
        <unit exponent="-1" prefix="pico" units="farad"/>
    </units>
    <units name="pA_per_pF">
        <unit prefix="pico" units="ampere"/>
        <unit exponent="-1" prefix="pico" units="farad"/>
    </units>
    <units name="mole_2_per_J_s_m_2">
        <unit exponent="2" units="mole"/>
        <unit exponent="-1" units="joule"/>
        <unit exponent="-1" units="second"/>
        <unit exponent="-2" units="metre"/>
    </units>
    <units name="per_ms">
        <unit exponent="-1" prefix="milli" units="second"/>
    </units>
    <units name="per_ms_mM">
        <unit exponent="-1" prefix="milli" units="second"/>
        <unit exponent="-1" prefix="milli" units="mole"/>
        <unit exponent="1" units="litre"/>
    </units>
    <units name="pL">
        <unit prefix="pico" units="litre"/>
    </units>
    <units name="l_per_mole">
        <unit units="litre"/>
        <unit exponent="-1" units="mole"/>
    </units>
    <units name="per_ms_mM_2">
        <unit exponent="-1" prefix="milli" units="second"/>
        <unit exponent="-2" prefix="milli" units="mole"/>
        <unit exponent="2" units="litre"/>
    </units>
    <units name="mM_per_ms">
        <unit prefix="milli" units="mole"/>
        <unit exponent="-1" units="litre"/>
        <unit exponent="-1" prefix="milli" units="second"/>
    </units>
    <units name="per_mM_3_s">
        <unit exponent="3" prefix="milli" units="mole"/>
        <unit exponent="-3" units="litre"/>
        <unit exponent="-1" prefix="milli" units="second"/>
    </units>
</model>
