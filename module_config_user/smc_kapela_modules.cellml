                                <cn cellml:units="mM_per_ms">0</cn>
                            </apply>
                            <apply>
                                <gt />
                                <apply>
                                    <minus />
                                    <ci>Vbar_cGMP</ci>
                                    <ci>V_cGMP</ci>
                                </apply>
                                <cn cellml:units="mM_per_ms">0</cn>
                            </apply>
